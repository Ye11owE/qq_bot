# ============ QQ Bot 运行配置 ============
# 复制此文件为 .env 并填入你的实际配置
# cp .env.example .env

# NoneBot2 驱动配置
DRIVER=~fastapi
HOST=0.0.0.0
PORT=8096
LOG_LEVEL=INFO
# 如果 NapCat 开启了反向 WebSocket token，请填写同一个值
ONEBOT_V11_ACCESS_TOKEN=""

# AI API 配置（必填）
# 支持任何兼容 OpenAI API 格式的服务（OpenAI / DeepSeek / 通义千问 / 自建服务等）
CHAT_API_KEY="your-api-key-here"
CHAT_API_BASE_URL="https://api.openai.com/v1"
# 文本与图片可分别指定模型，视觉模型留空时跟随文本模型
CHAT_TEXT_MODEL="gpt-4o-mini"
CHAT_VISION_MODEL=""

# 运行效果配置
QQBOT_REPLY_DELAY_MIN="3"
QQBOT_REPLY_DELAY_MAX="8"
QQBOT_SEGMENT_DELAY_MIN="4"
QQBOT_SEGMENT_DELAY_MAX="10"
QQBOT_SESSION_TIMEOUT="3600"
QQBOT_FILE_WORK_DIR="/tmp/qqbot_files"
# 额外允许 Agent 读写的目录，多个目录用系统路径分隔符，留空则允许项目目录、/tmp 和 /home
QQBOT_ALLOWED_DIRS=""

# ============ 邮件告警配置（可选）============
# QQ 邮箱 SMTP 授权码（非登录密码），在 QQ 邮箱设置 → 账户 → POP3/SMTP 中获取
ALERT_SMTP_SERVER="smtp.qq.com"
ALERT_SMTP_PORT="465"
ALERT_SMTP_USER="your-email@qq.com"
ALERT_SMTP_PASS="your-smtp-auth-code"
ALERT_TO_EMAIL="your-alert-receiver@example.com"
